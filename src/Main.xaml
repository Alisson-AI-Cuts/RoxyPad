<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RoxyPad" Width="410" Height="720" MinWidth="380" MinHeight="580" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#F7F3FF" AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
