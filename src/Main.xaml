   <Grid Panel.ZIndex="1">
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="44"/><RowDefinition Height="54"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#2C2540" BorderBrush="#8C70B4" BorderThickness="1" CornerRadius="10" Width="34" Height="34"><TextBlock Text="R" FontWeight="Bold" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Foreground><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#DBBDFF" Offset="0"/><GradientStop Color="#8AAFFF" Offset="1"/></LinearGradientBrush></TextBlock.Foreground></TextBlock></Border><TextBlock Text="RoxyPad" FontWeight="Bold" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="Warning" Content="!" FontWeight="Bold" FontSize="14" Width="32" Height="32" Padding="0" Margin="0,0,7,0" ToolTip="Prévia local&#10;Os áudios tocam neste computador. O envio de áudio ao microfone e ao Discord ainda não está disponível nesta versão." AutomationProperties.Name="Aviso sobre microfone e Discord"/><Button x:Name="Hide" Width="34" Height="32" Padding="0" ToolTip="Guardar na bandeja"><Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#F0EAF8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/></Button></StackPanel></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="All" Content="Todos" Background="#7250A8" Padding="13,5" FontWeight="Bold"/><Button x:Name="Favorites" Content="☆ Favoritos" Margin="7,0,0,0" Padding="13,5"/></StackPanel>
    <Grid Grid.Row="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Border Background="#24212D" BorderBrush="#383140" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0"><Grid><TextBox x:Name="Search" Background="Transparent" AutomationProperties.Name="Pesquisar áudio"/><TextBlock x:Name="SearchHint" Text="Pesquisar áudio…" Foreground="#968EA5" Margin="11,8" IsHitTestVisible="False"/></Grid></Border><Button x:Name="Add" Grid.Column="1" Content="＋" FontSize="20" Padding="0" Background="#7550B0" BorderBrush="#9C79D7" ToolTip="Adicionar áudios" AutomationProperties.Name="Adicionar áudios"/></Grid>
    <TextBlock x:Name="Count" Grid.Row="3" Text="SUA BIBLIOTECA · 0" FontWeight="Bold" FontSize="10" Foreground="#B8AFC5" VerticalAlignment="Center"/>
    <Grid Grid.Row="4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Rows"/></ScrollViewer><StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Sua biblioteca está vazia" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Use + ou arraste seus áudios para cá." Foreground="#B8AFC5" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
    <Border x:Name="DropOverlay" Grid.RowSpan="6" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="17" BorderBrush="#C7A6FF" BorderThickness="2" Background="#E91B1624"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="＋" FontSize="38" FontWeight="Bold" Foreground="#D9BEFF" HorizontalAlignment="Center"/><TextBlock Text="Solte para adicionar áudios" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="MP3 · WAV · M4A · AAC · WMA" FontSize="10" Foreground="#C7BBD5" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
    <Border Grid.Row="5" Background="#211D2B" BorderBrush="#51425F" BorderThickness="1" CornerRadius="14" Padding="12,9" Panel.ZIndex="2">
     <Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Button x:Name="PlayPause" Width="32" Height="32" Padding="0" Background="#503A71" BorderBrush="#8466AA" FontSize="13" FontWeight="Bold" Content="▶" ToolTip="Reproduzir" AutomationProperties.Name="Reproduzir ou pausar"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,4,0"><TextBlock x:Name="Now" Text="Escolha um áudio" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayerState" Text="Pronto para tocar" FontSize="9" Foreground="#A89AB8" Margin="0,2,0,0"/></StackPanel><Border x:Name="VolumeHover" Grid.Column="1" Grid.ColumnSpan="2" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="10" ClipToBounds="True" Panel.ZIndex="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Margin="6,0,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Slider x:Name="Volume" Grid.Column="0" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Volume do áudio no fone e no microfone" ToolTip="Volume do áudio no fone e no microfone"/><TextBlock x:Name="VolumeLabel" Grid.Column="1" Text="50%" FontSize="10" FontWeight="Bold" Foreground="#DCC9FF" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/></Grid><Button x:Name="VolumeButton" Grid.Column="1" Width="30" Height="30" Padding="0" ToolTip="Volume · passe o mouse para ajustar; clique para silenciar" AutomationProperties.Name="Volume e silenciar"><Canvas Width="16" Height="16"><Path Data="M 1,5 L 4,5 L 8,2 L 8,14 L 4,11 L 1,11 Z" Fill="#DCC9FF"/><Path x:Name="VolumeWaves" Data="M 10,5 C 11.5,6 11.5,10 10,11 M 12,3 C 14.5,5 14.5,11 12,13" Stroke="#DCC9FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Button></Grid></Border></Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="83"/></Grid.ColumnDefinitions><Slider x:Name="Seek" Minimum="0" Maximum="1" SmallChange="1" LargeChange="5" IsEnabled="False" VerticalAlignment="Center"/><TextBlock x:Name="Time" Grid.Column="1" Text="0:00 / 0:00" FontSize="10" Foreground="#A49AAE" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Row="2" ToolTip="Volume da sua voz enviado ao microfone (CABLE Output). Aumente se seus amigos acharem sua voz baixa."><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><TextBlock Text="Voz" FontSize="10" FontWeight="Bold" Foreground="#B8AFC5" VerticalAlignment="Center"/><Slider x:Name="MicGain" Grid.Column="1" Minimum="1" Maximum="8" Value="4" SmallChange="0.1" LargeChange="0.5" VerticalAlignment="Center" AutomationProperties.Name="Volume da voz no microfone"/><TextBlock x:Name="MicGainLabel" Grid.Column="2" Text="400%" FontSize="10" FontWeight="Bold" Foreground="#DCC9FF" HorizontalAlignment="Right" VerticalAlignment="Center"/><Button x:Name="Denoise" Grid.Column="3" Content="Isolar voz" FontSize="10" FontWeight="Bold" Padding="0" Height="24" Margin="8,0,0,0" ToolTip="Remove ruído de fundo só da sua voz (os áudios do RoxyPad não passam pelo filtro). Use com o modo estúdio do Discord." AutomationProperties.Name="Isolar voz"/></Grid>
      <Grid Grid.Row="3" ToolTip="Fecha o microfone quando não é fala (fungada, respiração, tosse leve, teclado). Mais alto corta mais; se começar a cortar palavras baixas, diminua."><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><TextBlock Text="Portão" FontSize="10" FontWeight="Bold" Foreground="#B8AFC5" VerticalAlignment="Center"/><Slider x:Name="Gate" Grid.Column="1" Minimum="0" Maximum="0.95" Value="0.6" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" AutomationProperties.Name="Rigor do portão de voz"/><TextBlock x:Name="GateLabel" Grid.Column="2" Text="60%" FontSize="10" FontWeight="Bold" Foreground="#DCC9FF" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     </Grid>
    </Border>
