   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A47AE8"/><Setter TargetName="Surface" Property="Background" Value="#352B43"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D3B5FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F7F3FF"/><Setter Property="Background" Value="#24212D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="White"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="TrackPart" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="26"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="SmallChange" Value="0.01"/><Setter Property="LargeChange" Value="0.1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid x:Name="SliderSurface" Background="Transparent" Margin="2,0"><Border Height="4" Background="#393140" CornerRadius="2" VerticalAlignment="Center" Margin="6,0"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource TrackPart}" Background="#B795F5" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource TrackPart}" Background="#393140" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse x:Name="Dot" Width="12" Height="12" Fill="#DCC9FF" Stroke="#B795F5" StrokeThickness="2"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="White"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Dot" Property="Fill" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderSurface" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderSurface" Property="Background" Value="#30243E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="5" HorizontalAlignment="Center" CornerRadius="2.5" Background="#51445E"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#241F32"/><Setter Property="Foreground" Value="#F6F1FF"/><Setter Property="BorderBrush" Value="#725B8B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="11"/><Setter Property="MaxWidth" Value="285"/></Style>
  <Style x:Key="RoxyMenu" TargetType="ContextMenu"><Setter Property="Foreground" Value="#F2ECFB"/><Setter Property="FontSize" Value="12"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Margin="0,0,10,10" Background="#211C2B" BorderBrush="#4E4160" BorderThickness="1" CornerRadius="12" Padding="5"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black"/></Border.Effect><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RoxyMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#F2ECFB"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,8" MinWidth="220"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter x:Name="IconSlot" ContentSource="Icon" VerticalAlignment="Center" Opacity="0.75"/><ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False"/><Border x:Name="Hint" Grid.Column="2" Margin="14,0,0,0" Padding="7,2" CornerRadius="5" Background="#2E2640" BorderBrush="#5B4A70" BorderThickness="1"><TextBlock Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="#CDB8F5"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="InputGestureText" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#352849"/><Setter TargetName="IconSlot" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RoxyMenuSeparator" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,5" Background="#3A3147"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="8" BorderThickness="1" CornerRadius="22" Padding="20" ClipToBounds="True">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#211A2F" Offset="0"/><GradientStop Color="#17151E" Offset="0.55"/><GradientStop Color="#171B2B" Offset="1"/></LinearGradientBrush></Border.Background>
